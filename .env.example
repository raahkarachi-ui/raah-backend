PORT=3000
# Neon: use the POOLED string (host contains -pooler) for the app.
# Keep ?sslmode=require. Use the DIRECT string only for psql migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379
# Generate a NEW long random value; never reuse the local one.
JWT_SECRET=change-me
GOOGLE_MAPS_API_KEY=
PLATFORM_FEE_PKR=20
WELFARE_SHARE_BPS=6000
BASE_FARE_PKR=80
PER_KM_PKR=35
PER_MIN_PKR=3
MINIMUM_FARE_PKR=150
ROUND_FARE_TO_PKR=5
REFERENCE_PETROL_PKR=398.96
